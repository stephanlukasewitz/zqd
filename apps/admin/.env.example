# Zugang zum Dashboard (eigene Zugangsdaten, unabhängig von GitHub)
ADMIN_EMAIL=
# Entweder das Passwort direkt (bei Vercel als "Sensitive" markieren) …
ADMIN_PASSWORD=
# … oder stattdessen nur den Hash, erzeugt mit: pnpm --filter admin passwort
# ADMIN_PASSWORD_HASH=
# Zufälliger langer Wert, z. B. openssl rand -hex 32
SESSION_SECRET=

# GitHub: fein granularer Token, nur dieses Repository, Berechtigung "Contents: Read and write"
GITHUB_TOKEN=
GITHUB_REPO=stephanlukasewitz/zqd
# optional
# GITHUB_BASE=main
# GITHUB_DRAFT=entwurf

# Nur für lokale Entwicklung: Dateien direkt im Repo bearbeiten statt über GitHub
# CONTENT_BACKEND=local
# LOCAL_REPO=../..
